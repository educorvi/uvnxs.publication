<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="uvnxs.publication"
    >

  <genericsetup:registerProfile
      name="default"
      title="uvnxs.publication: Install"
      description="Package to configure a new uvnxs.publication site"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="uninstall"
      title="uvnxs.publication: Uninstall"
      description="Uninstall uvnxs.publication setup."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/uninstall"
      />

  <genericsetup:registerProfile
      name="to_1017"
      title="Migrate to 1017"
      description="Applies the uvnxs.publication 1017 upgrade."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_1017"
      />

  <genericsetup:registerProfile
      name="to_1018"
      title="Migrate to 1018"
      description="Applies the uvnxs.publication 1018 upgrade."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_1018"
      />

  <!-- Hide Uninstall Profile-->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="uvnxs.publication"
      />


  <include package=".upgrades" />

</configure>
