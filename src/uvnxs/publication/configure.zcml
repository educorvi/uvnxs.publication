<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="uvnxs.publication"
    >

  <i18n:registerTranslations directory="locales" />

  <browser:resourceDirectory
      xmlns:browser="http://namespaces.zope.org/browser"
      name="uvnxs.publication"
      directory="static"
      />
  <browser:resourceDirectory
      xmlns:browser="http://namespaces.zope.org/browser"
      name="uvnxs.publication.xml-editor"
      directory="vue/xml-editor-webcomponent/dist"
      />
  <include package="Products.CMFPlone" />
  <include
      package="Products.CMFCore"
      file="permissions.zcml"
      />


  <include file="dependencies.zcml" />
  <include file="profiles.zcml" />
  <include file="permissions.zcml" />
  <include package=".api" />
  <include package=".serializers" />

  <include package=".behaviors" />
  <include package=".views" />
  <include file="widgets.zcml" />
  <!-- Create Body on Article creation -->
  <subscriber
      for="uvnxs.publication.content.article.IArticle
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler="uvnxs.publication.subscribers.create_body_in_article"
      />
  <subscriber
      for="zope.container.interfaces.IContained
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler="uvnxs.publication.subscribers.article_ancestor_change_handler"
      />

  <!-- Save jats and html on article version creation -->
  <subscriber
      for="uvnxs.publication.content.article.IArticle
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler="uvnxs.publication.subscribers.save_jats_and_html_on_version"
      />

  <adapter
      factory=".collectionfilter.groupby_modifier"
      name="vur-facets"
      />

</configure>
