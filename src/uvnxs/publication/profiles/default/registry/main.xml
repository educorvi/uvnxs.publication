<?xml version="1.0" encoding="utf-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="uvnxs.publication"
>

  <records interface="uvnxs.publication.interfaces.IUvnxsPublicationSettings"
           prefix="uvnxs.publication"
  />

  <records interface="Products.CMFPlone.interfaces.IBundleRegistry"
           prefix="plone.bundles/uvnxs.publication.xml-editor"
  >
    <value key="jscompilation">++resource++uvnxs.publication.vue/xml-editor-webcomponent/dist/xml-editor.umd.js</value>
    <value key="enabled">True</value>
    <value key="load_async">False</value>
    <value key="load_defer">True</value>
    <value key="depends">plone</value>
  </records>

</registry>
