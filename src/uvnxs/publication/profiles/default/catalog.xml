<?xml version="1.0" encoding="utf-8"?>
<object name="portal_catalog">

  <!-- FieldIndex for single-value text fields -->
  <index meta_type="FieldIndex"
         name="journal_id"
  ><indexed_attr value="journal_id" /></index>

  <index meta_type="FieldIndex"
         name="journal_title"
  ><indexed_attr value="journal_title" /></index>

  <index meta_type="FieldIndex"
         name="journal_subtitle"
  ><indexed_attr value="journal_subtitle" /></index>

  <index meta_type="FieldIndex"
         name="article_id"
  ><indexed_attr value="article_id" /></index>

  <!-- KeywordIndex for list fields -->
  <index meta_type="KeywordIndex"
         name="article_subtitle"
  ><indexed_attr value="article_subtitle" /></index>

  <index meta_type="KeywordIndex"
         name="relatedItems"
  ><indexed_attr value="relatedItems" /></index>

  <!-- DateIndex for date fields -->
  <index meta_type="DateIndex"
         name="pub_date_ausgabedatum"
  ><indexed_attr value="pub_date_ausgabedatum" /></index>

  <!-- DateIndex for date fields -->
  <index meta_type="DateIndex"
         name="pub_date_aktualisierte_fassung"
  ><indexed_attr value="pub_date_aktualisierte_fassung" /></index>

  <index meta_type="FieldIndex"
         name="abstract_short_title"
  ><indexed_attr value="abstract_short_title" /></index>

  <index meta_type="FieldIndex"
         name="abstract_short"
  ><indexed_attr value="abstract_short" /></index>

  <!-- KeywordIndex for list fields -->
  <index meta_type="KeywordIndex"
         name="subjects"
  ><indexed_attr value="subjects" /></index>

  <index meta_type="FieldIndex"
         name="webcode"
  ><indexed_attr value="webcode" /></index>

  <index meta_type="FieldIndex"
         name="organisationseinheit"
  ><indexed_attr value="organisationseinheit" /></index>

  <index meta_type="FieldIndex"
         name="fachbereich"
  ><indexed_attr value="fachbereich" /></index>

  <index meta_type="FieldIndex"
         name="sachgebiet"
  ><indexed_attr value="sachgebiet" /></index>


  <!-- ZCTextIndex for multi-sentence text fields -->
  <!--  <index meta_type="ZCTextIndex" name="copyright_statement">-->
  <!--    <indexed_attr value="copyright_statement" />-->
  <!--    <extra name="index_type" value="Okapi BM25 Rank" />-->
  <!--    <extra name="lexicon_id" value="plone_lexicon" />-->
  <!--  </index>-->
  <index meta_type="ZCTextIndex"
         name="abstract_short"
  >
    <indexed_attr value="abstract_short" />
    <extra name="index_type"
           value="Okapi BM25 Rank"
    />
    <extra name="lexicon_id"
           value="plone_lexicon"
    />
  </index>

  <index meta_type="ZCTextIndex"
         name="abstract_summary"
  >
    <indexed_attr value="abstract_summary" />
    <extra name="index_type"
           value="Okapi BM25 Rank"
    />
    <extra name="lexicon_id"
           value="plone_lexicon"
    />
  </index>

  <!-- Aggregated text of an Article's descendants, see Article.SearchableFullText -->
  <index meta_type="ZCTextIndex"
         name="vur_fulltext"
  >
    <indexed_attr value="SearchableFullText" />
    <extra name="index_type"
           value="Okapi BM25 Rank"
    />
    <extra name="lexicon_id"
           value="plone_lexicon"
    />
  </index>

  <!-- Metadata columns (for use in listings without waking up objects) -->
  <column value="journal_id" />
  <column value="journal_title" />
  <column value="journal_subtitle" />
  <column value="article_id" />
  <column value="article_subtitle" />
  <column value="relatedItems" />
  <column value="pub_date_ausgabedatum" />
  <column value="pub_date_aktualisierte_fassung" />
  <column value="abstract_short_title" />
  <column value="abstract_short" />
  <column value="subjects" />
  <column value="webcode" />
  <column value="organisationseinheit" />
  <column value="fachbereich" />
  <column value="sachgebiet" />

</object>
