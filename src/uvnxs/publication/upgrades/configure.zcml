<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <!-- Example upgrade step
  <genericsetup:upgradeSteps
      profile="uvnxs.publication:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Update registry value"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>
  -->

  <genericsetup:upgradeStep
      title="Migrate to 1001"
      description="Reimport registry to update IUvnxsPublicationSettings."
      profile="uvnxs.publication:default"
      source="1000"
      destination="1001"
      handler=".to_1001.reimport_registry_step"
      />

  <genericsetup:upgradeStep
      title="Migrate to 1002"
      description="Register xml-editor web component bundle in resource registry."
      profile="uvnxs.publication:default"
      source="1001"
      destination="1002"
      handler=".to_1002.add_xml_editor_bundle"
      />

  <genericsetup:upgradeStep
      title="Migrate to 1003"
      description="Add jats-list-view as available view method on Folder FTI."
      profile="uvnxs.publication:default"
      source="1002"
      destination="1003"
      handler=".to_1003.add_jats_list_view"
      />

  <genericsetup:upgradeStep
      title="Migrate to 1004"
      description="Fix translation of Body, prohibit creation of Section via UI."
      profile="uvnxs.publication:default"
      source="1003"
      destination="1004"
      handler=".to_1004.apply_type_changes"
      />

  <genericsetup:upgradeStep
      title="Migrate to 1005"
      description="Register the new article edit view."
      profile="uvnxs.publication:default"
      source="1004"
      destination="1005"
      handler=".to_1005.register_new_article_edit_view"
      />

  <genericsetup:upgradeStep
      title="Migrate to 1006"
      description="Delete content type Front."
      profile="uvnxs.publication:default"
      source="1005"
      destination="1006"
      handler=".to_1006.delete_content_type_front"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>
