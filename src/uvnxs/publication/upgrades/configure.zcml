<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

  <!-- Example upgrade step
  <genericsetup:upgradeSteps
      profile="uvnxs.publication:default"
      source="1000"
      destination="1001"
      >
    <genericsetup:upgradeDepends
        title="Update registry value"
        import_steps="plone.app.registry"
        />
  </genericsetup:upgradeSteps>
  -->

  <genericsetup:upgradeStep
      title="Migrate to 1001"
      description="Reimport registry to update IUvnxsPublicationSettings."
      source="1000"
      destination="1001"
      handler=".to_1001.reimport_registry_step"
      profile="uvnxs.publication:default"
      />

  <!-- -*- extra stuff goes here -*- -->

</configure>
