<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="uvnxs.publication"
>
  <body>
    <metal:block fill-slot="main">
      <div class="vur">
        <section>
          <h1>Recherche</h1>
          <tal:block tal:condition="python: view.has_query or not view.has_subjects">
            <form class="vur-search"
                  action=""
                  role="search"
                  tal:attributes="
                    action string:${context/portal_url}/@@search;
                  "
            >
              <label for="search-query">Im Regelwerk suchen</label>
              <div class="d-flex w-100">
                <input id="search-query"
                       name="SearchableText"
                       placeholder="Suchbegriff oder Webcode"
                       type="search"
                       tal:attributes="
                         value view/query;
                       "
                />
                <button type="submit">Suchen</button>
              </div>
            </form>
          </tal:block>
          <tal:block tal:condition="python: not view.has_query and view.has_subjects">
            <div class="vur-subjects">
              <p class="label">Schlagw&ouml;rter</p>
              <p class="subjects"
                 tal:content="python: ', '.join(view.subjects)"
              ></p>
            </div>
          </tal:block>


          <tal:block tal:condition="not: view/has_results">
            <section class="vur-no-results">
              <tal:block tal:condition="view/query_parse_error">
                <p>Fehler bei der Verarbeitung der Suchanfrage (${view/query_parse_error})</p>
              </tal:block>
              <tal:block tal:condition="python: not view.query_parse_error and (view.has_query or view.has_subjects)">
                <p>Keine Ergebnisse gefunden.</p>
              </tal:block>
              <tal:block tal:condition="python: not view.has_query and not view.has_subjects">
                <p>Bitte geben Sie einen Suchbegriff oder Webcode ein.</p>
              </tal:block>
            </section>
          </tal:block>
        </section>

        <tal:block tal:condition="view/has_results">
          <search-results filter-heading="Ergebnisse filtern"
                          tal:attributes="
                            search-results view/documents_json;
                            fachbereiche-options view/fachbereiche_json;
                            sachgebiete-options view/sachgebiete_json;
                            rubriken-options view/rubriken_json;
                          "
          ></search-results>
        </tal:block>
      </div>
    </metal:block>

    <metal:block fill-slot="style_slot">
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/common.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/search-field.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication.webcomponents/search-results.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/search-filter-view.css;
            "
      />
    </metal:block>
    <metal:block fill-slot="javascript_head_slot">
      <script type="module"
              tal:attributes="
                src string:${context/portal_url}/++resource++uvnxs.publication.webcomponents/search-results.js;
              "
      ></script>
    </metal:block>
  </body>
</html>
