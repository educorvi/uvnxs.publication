<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="uvnxs.publication"
>
  <body>
    <metal:block fill-slot="main">
      <div class="vur">
        <section class="vur-header">
          <h1 tal:content="view/heading"></h1>
          <tal:block tal:condition="python: view.description or view.text">
            <div class="vur-header-description-container">
              <tal:block tal:condition="view/description">
                <p class="vur-header-description"
                   tal:content="structure view/description"
                ></p>
              </tal:block>
              <tal:block tal:condition="view/text">
                <button class="vur-header-text-button btn btn-secondary btn-sm collapsed"
                        aria-controls="collapseText"
                        aria-expanded="false"
                        type="button"
                        data-bs-target="#collapseText"
                        data-bs-toggle="collapse"
                >
                  <span class="label-collapsed">Mehr anzeigen</span>
                  <span class="label-expanded">Weniger anzeigen</span>
                </button>
              </tal:block>
            </div>
          </tal:block>
          <tal:block tal:condition="view/text">
            <div class="vur-header-text collapse"
                 id="collapseText"
                 tal:content="structure view/text"
            ></div>
          </tal:block>
          <tal:block tal:condition="python: view.has_query or not view.has_subjects">
            <form class="vur-search"
                  action=""
                  role="search"
                  tal:attributes="
                    action string:${context/portal_url}/@@search;
                  "
            >
              <label for="search-query">Im Regelwerk suchen</label>
              <div class="d-flex w-100">
                <input id="search-query"
                       name="SearchableText"
                       placeholder="Suchbegriff oder Webcode"
                       type="search"
                       tal:attributes="
                         value view/query;
                       "
                />
                <button type="submit">Suchen</button>
              </div>
            </form>
          </tal:block>
          <tal:block tal:condition="python: not view.has_query and view.has_subjects">
            <div class="vur-subjects">
              <p class="label">Schlagw&ouml;rter</p>
              <p class="subjects"
                 tal:content="python: ', '.join(view.subjects)"
              ></p>
            </div>
          </tal:block>


          <tal:block tal:condition="not: view/has_results">
            <section class="vur-no-results">
              <tal:block tal:condition="view/query_parse_error">
                <p>Fehler bei der Verarbeitung der Suchanfrage (${view/query_parse_error})</p>
              </tal:block>
              <tal:block tal:condition="python: not view.query_parse_error and (view.has_query or view.has_subjects)">
                <p tal:content="view/no_results_message"></p>
              </tal:block>
              <tal:block tal:condition="python: not view.has_query and not view.has_subjects">
                <p>Bitte geben Sie einen Suchbegriff oder Webcode ein.</p>
              </tal:block>
            </section>
          </tal:block>
        </section>

        <tal:block tal:condition="view/has_results">
          <search-results tal:attributes="
                            sort-by view/sort_by;
                            filter-heading view/filter_heading;
                            search-results view/documents_json;
                            fachbereiche-options view/fachbereiche_json;
                            sachgebiete-options view/sachgebiete_json;
                            rubriken-options view/rubriken_json;
                          "></search-results>
        </tal:block>
      </div>
    </metal:block>

    <metal:block fill-slot="style_slot">
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/root.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/common.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/search-view.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication.webcomponents/search-results.css;
            "
      />
    </metal:block>
    <metal:block fill-slot="javascript_head_slot">
      <script type="module"
              tal:attributes="
                src string:${context/portal_url}/++resource++uvnxs.publication.webcomponents/search-results.js;
              "
      ></script>
      <script defer=""
              tal:attributes="
                src string:${context/portal_url}/++resource++uvnxs.publication/js/hide-search-icon.js;
              "
      >
      </script>
    </metal:block>
  </body>
</html>
