<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="uvnxs.publication"
    >


  <browser:page
      name="vur-landing-page"
      for="uvnxs.publication.content.vur_landing_page.IVurLandingPage"
      class=".vur_landing_page_view.VuRLandingPageView"
      template="vur_landing_page_view.pt"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="VuR Landing Page"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="vur-filter-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".vur_filter_view.VuRFilterView"
      template="vur_filter_view.pt"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="VuR Filter View"
      i18n:domain="uvnxs.publication"
      />

  <!-- Overrides Plone's default @@search view to search only Articles. -->
  <browser:page
      name="search"
      for="plone.base.interfaces.INavigationRoot"
      class=".vur_search_view.VuRSearchView"
      template="vur_search_view.pt"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="jats-list-view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".jats_list_view.JatsListView"
      template="jats_list_view.pt"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="JATS List View"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="jats-html-view"
      for="uvnxs.publication.content.article.IArticle"
      class=".jats_html_view.JATSHtmlView"
      template="jats_html_view.pt"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="JATS HTML View"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="jats-html-edit-view"
      for="uvnxs.publication.content.article.IArticle"
      class=".jats_html_view.JATSHtmlEditView"
      template="jats_html_view.pt"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="JATS HTML Edit View"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="jats-html-raw"
      for="uvnxs.publication.content.article.IArticle"
      class=".jats_html_view.JATSHtmlRawView"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="jats-pdf-view"
      for="uvnxs.publication.content.article.IArticle"
      class=".jats_html_view.JATSPdfView"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      i18n:domain="uvnxs.publication"
      />

  <browser:page
      name="jats-view"
      for="uvnxs.publication.content.article.IArticle"
      class=".jats_view.JATSView"
      permission="zope2.View"
      layer="uvnxs.publication.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="JATS View"
      i18n:domain="uvnxs.publication"
      />

  <include package="plone.app.registry" />

  <browser:page
      name="uvnxs-publication-settings"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      class=".controlpanel.UvnxsPublicationSettingsView"
      permission="cmf.ManagePortal"
      />

</configure>
