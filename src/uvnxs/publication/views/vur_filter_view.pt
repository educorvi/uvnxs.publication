<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="uvnxs.publication"
>
  <body>
    <metal:block fill-slot="main">
      <div class="vur">
        <section class="vur-header">
          <h1 tal:content="structure context/title"></h1>
          <tal:block tal:condition="context/description">
            <p class="vur-header-description"
               tal:content="structure context/description"
            ></p>
          </tal:block>

        </section>

        <search-results tal:attributes="
                          search-results view/documents_json;
                          fachbereiche-options view/fachbereiche_json;
                          sachgebiete-options view/sachgebiete_json;
                        "></search-results>
      </div>
    </metal:block>

    <metal:block fill-slot="style_slot">
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/css/common.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication.webcomponents/search-results.css;
            "
      />
    </metal:block>
    <metal:block fill-slot="javascript_head_slot">
      <script type="module"
              tal:attributes="
                src string:${context/portal_url}/++resource++uvnxs.publication.webcomponents/search-results.js;
              "
      ></script>
    </metal:block>
  </body>
</html>
