<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="uvnxs.publication"
>
  <body>
    <metal:block fill-slot="main">
      <div class="vur">
        <section class="vur-header">
          <h1 tal:content="structure context/title"></h1>
          <tal:block tal:condition="context/description">
            <p class="vur-header-description"
               tal:content="structure context/description"
            ></p>
          </tal:block>

          <section class="vur-filter-section">
            <div class="vur-filter-section__filters">
              <div class="vur-filter-section__header d-flex flex-wrap align-items-baseline justify-content-between gap-3">
                <h2>Dokumente filtern</h2>
                <p class="small">Mehrfachauswahl erweitert die Trefferliste.</p>
              </div>

              <div class="vur-filter-section__filterlist">
                <div class="form-group">
                  <label id="fachbereich-label"
                         for="fachbereich-multi-select"
                  >Fachbereich</label>
                  <div class="form-multi-select"
                       data-max-chips="5"
                       data-placeholder="Auswählen"
                  >
                    <div class="ms-field">
                      <button class="ms-trigger"
                              id="fachbereich-multi-select"
                              aria-controls="multi-select-listbox"
                              aria-expanded="false"
                              aria-haspopup="listbox"
                              aria-labelledby="fachbereich-label multi-select-value"
                              type="button"
                      ></button>
                      <span class="ms-value"></span>
                      <span class="ms-chevron"
                            aria-hidden="true"
                      ></span>
                    </div>
                    <ul class="ms-listbox"
                        id="multi-select-listbox"
                        aria-labelledby="fachbereich-label"
                        aria-multiselectable="true"
                        hidden
                        role="listbox"
                    >
                      <li class="ms-option ms-option-all"
                          id="fachbereich-multi-select-option-all"
                          aria-selected="false"
                          role="option"
                          tabindex="-1"
                      >
                        <span class="ms-check"
                              aria-hidden="true"
                        ></span><span class="ms-option-label">Alle ausw&auml;hlen</span>
                      </li>
                      <tal:block tal:repeat="fachbereich view/fachbereiche">
                        <li class="ms-option"
                            aria-selected="false"
                            role="option"
                            tabindex="-1"
                            tal:attributes="
                              data-value fachbereich;
                            "
                        >
                          <span class="ms-check"
                                aria-hidden="true"
                          ></span><span class="ms-option-label"
                                tal:content="fachbereich"
                          ></span>
                        </li>
                      </tal:block>
                    </ul>
                    <span class="ms-visually-hidden"
                          aria-live="polite"
                    ></span>
                  </div>
                </div>
                <div class="form-group flex-fill">
                  <label id="sachgebiet-label"
                         for="sachgebiet-multi-select"
                  >Sachgebiet</label>
                  <div class="form-multi-select"
                       data-max-chips="5"
                       data-placeholder="Auswählen"
                  >
                    <div class="ms-field">
                      <button class="ms-trigger"
                              id="sachgebiet-multi-select"
                              aria-controls="multi-select-listbox"
                              aria-expanded="false"
                              aria-haspopup="listbox"
                              aria-labelledby="sachgebiet-label multi-select-value"
                              type="button"
                      ></button>
                      <span class="ms-value"></span>
                      <span class="ms-chevron"
                            aria-hidden="true"
                      ></span>
                    </div>
                    <ul class="ms-listbox"
                        id="multi-select-listbox"
                        aria-labelledby="sachgebiet-label"
                        aria-multiselectable="true"
                        hidden
                        role="listbox"
                    >
                      <li class="ms-option ms-option-all"
                          id="sachgebiet-multi-select-option-all"
                          aria-selected="false"
                          role="option"
                          tabindex="-1"
                      >
                        <span class="ms-check"
                              aria-hidden="true"
                        ></span><span class="ms-option-label">Alle ausw&auml;hlen</span>
                      </li>
                      <tal:block tal:repeat="sachgebiet view/sachgebiete">
                        <li class="ms-option"
                            aria-selected="false"
                            role="option"
                            tabindex="-1"
                            tal:attributes="
                              data-value sachgebiet;
                            "
                        >
                          <span class="ms-check"
                                aria-hidden="true"
                          ></span><span class="ms-option-label"
                                tal:content="sachgebiet"
                          ></span>
                        </li>
                      </tal:block>
                    </ul>
                    <span class="ms-visually-hidden"
                          aria-live="polite"
                    ></span>
                  </div>
                </div>
              </div>
            </div>

            <div class="vur-filter-section__sorting d-flex flex-wrap align-items-center justify-content-between gap-3">
              <div class="vur-filter-section__results-count">
                <strong></strong>
                <span>Dokumente</span>
              </div>
              <div class="vur-filter-section__sort d-flex align-items-center gap-3">
                <label for="sort-select"><strong>Sortieren nach</strong></label>
                <select class="form-select"
                        id="sort-select"
                        name="sort-select"
                >
                  <option selected
                          value="article_id"
                  >Artikel-ID</option>
                  <option value="title">Titel</option>
                  <option value="pub_date">Ausgabedatum</option>
                </select>
              </div>
            </div>
          </section>
        </section>

        <datalist id="vur-documents-json"
                  tal:attributes="
                    json string:${view/documents_json};
                  "
        ></datalist>
        <section class="vur-documents-list"></section>
      </div>
    </metal:block>

    <metal:block fill-slot="style_slot">
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/common.css;
            "
      />
      <link rel="stylesheet"
            type="text/css"
            tal:attributes="
              href string:${context/portal_url}/++resource++uvnxs.publication/folder-filter-view.css;
            "
      />
    </metal:block>
    <metal:block fill-slot="javascript_head_slot">
      <script type="module"
              tal:attributes="
                src string:${context/portal_url}/++resource++uvnxs.publication/theme/multi-select.js;
              "
      ></script>
      <script type="module"
              tal:attributes="
                src string:${context/portal_url}/++resource++uvnxs.publication/folder-filter-view.js;
              "
      ></script>
    </metal:block>
  </body>
</html>
