<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="edi.formactions"
>
  <body>
    <metal:block fill-slot="content-core">

      <!--Upload Form-->
      <form enctype="multipart/form-data"
            method="post"
      >
        <fieldset>
          <legend i18n:translate="upload_jats_legend">Import JATS XML</legend>

          <div class="alert alert-info mb-2"
               role="alert"
               i18n:translate="upload_jats_note"
          ><strong>Note:</strong>
             Upload
        can take a few moments depending on the
        size of the XML file.
          </div>

          <div class="mb-2">
            <label class="form-label"
                   for="jats_name"
                   i18n:translate="upload_jats_name_label"
            >Name (optional):</label>
            <input class="form-control"
                   id="jats_name"
                   name="jats_name"
                   type="text"
            />
            <div class="form-text"
                 i18n:translate="upload_jats_name_desc"
            >If left empty, the filename will be used as the
          name.
            </div>
          </div>

          <div class="mb-2">
            <label class="form-label"
                   for="jats_file"
                   i18n:translate="upload_jats_label"
            >Select XML file:</label>
            <input class="form-control"
                   id="jats_file"
                   accept=".xml,application/xml,text/xml"
                   name="jats_file"
                   required
                   type="file"
            />
          </div>
          <input class="btn btn-primary w-100 mt-2"
                 type="submit"
                 value="Upload"
                 i18n:attributes="value upload_jats_submit"
          />
        </fieldset>
      </form>

    </metal:block>
  </body>
</html>
